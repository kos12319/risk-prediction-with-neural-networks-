@article{verbraken2014development,
  title={Development and application of consumer credit scoring models using profit-based classification measures},
  author={Verbraken, Thomas and Bravo, Cristián and Weber, Richard and Baesens, Bart},
  journal={European Journal of Operational Research},
  volume={238},
  number={2},
  pages={505--513},
  year={2014},
  publisher={Elsevier},
  doi={10.1016/j.ejor.2014.04.001},
  note={STRONGLY CONFIRMS: In asymmetric cost settings, select thresholds on validation by expected utility. Introduces "Expected Maximum Profit (EMP) measure" specifically for credit scoring that "takes into account the expected profits and losses of credit granting." Provides methodology for calculating optimal cutoff values based on cost-benefit analysis rather than traditional accuracy metrics.},
  abstract={This paper presents a new approach for consumer credit scoring, by tailoring a profit-based classification performance measure to credit risk modeling. This performance measure takes into account the expected profits and losses of credit granting and thereby better aligns the model developers' objectives with those of the lending company. It is based on the Expected Maximum Profit (EMP) measure and is used to find a trade-off between the expected losses – driven by the exposure of the loan and the loss given default – and the operational income given by the loan.}
}

